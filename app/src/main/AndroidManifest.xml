<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 无障碍被关闭时发送提醒通知（Android 13+ 需运行时授权） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 息屏确认弹窗：悬浮窗覆盖在所有应用之上（无需后台启动 Activity） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 锁屏后结束目标视频应用的后台进程（只能作用于后台进程，不能杀前台进程） -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- 常驻前台服务（Android 14 需同时声明 specialUse 类型权限） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 开机自启：重启后恢复保活链路 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 请求加入电池优化白名单（防止后台被省电策略杀掉） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 驾驶模式检测（可选，默认关）：仅读取系统已有的最后已知定位（速度），不主动请求定位 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- 驾驶检测降级信号：监听 WiFi↔蜂窝 网络切换（不访问网络内容，零联网） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 仓库监听（同步更新）：应用唯一的联网行为，仅请求用户配置的仓库地址 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 下载完成后调起系统安装器（Android 8+ 需未知来源安装授权） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 传感器（加速度计）无需声明权限：BODY_SENSORS 仅限心率等敏感传感器 -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AutoScreenOff">

        <!-- 更新 APK 安装授权（应用私有外部目录 files/Download/updates/） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.autoscreenoff.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 主界面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 第二页：单个应用详细配置 -->
        <activity
            android:name=".AppDetailActivity"
            android:exported="false" />

        <!-- 无障碍服务：检测前台应用 / 滑动 / 触摸 -->
        <service
            android:name=".MonitorAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 设备管理员：用于立即锁定屏幕 + （可选）强力暂停目标应用 -->
        <receiver
            android:name=".DeviceAdminReceiver"
            android:exported="true"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- 常驻前台服务：保活载体 + 状态通知 + 一键暂停（Android 14 必须声明类型）。
             location 类型仅在开启驾驶检测且已授权时于运行时按需启用（见 startForegroundCompat） -->
        <service
            android:name=".MonitorForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="后台监测视频应用使用状态，实现睡着自动锁屏；常驻通知提供暂停与状态入口" />
        </service>

        <!-- 快捷设置磁贴：一键开关总开关 -->
        <service
            android:name=".PauseTileService"
            android:exported="true"
            android:icon="@drawable/ic_moon"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- 开机自启 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <!-- 必须是 android.intent.action.BOOT_COMPLETED（系统实际广播的 action，
                     之前误写成 android.app.action.BOOT_COMPLETED 导致开机自启从不触发） -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 更新安装会话状态回调（显式 PendingIntent 目标，无需 exported） -->
        <receiver android:name=".UpdateStatusReceiver" />
    </application>

    <!-- Android 11+ 包可见性声明：
         1. 允许查询手机上已安装的桌面应用列表（添加目标应用功能）
         2. 允许解析「安装 APK」的 Activity（系统安装器，更新流程需要） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data
                android:mimeType="application/vnd.android.package-archive"
                android:scheme="content" />
        </intent>
        <!-- 按包名直接声明常见系统安装器的可见性（部分系统用新式过滤器，意图匹配不可靠） -->
        <package android:name="com.android.packageinstaller" />
        <package android:name="com.google.android.packageinstaller" />
    </queries>

</manifest>
